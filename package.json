{
  "name": "louver-lyric-shorts-maker",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Generate 9:16 lyric short videos from a single image / video / audio file with AI-extracted lyrics — no Python, no PATH config required.",
  "author": {
    "name": "Louver",
    "email": "support@louver.app"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/freemilesarea-boop/Louver-Lyric-Shorts-Maker-MVP",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --publish never && tsx scripts/verify-packaged-binaries.ts",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never && tsx scripts/verify-packaged-binaries.ts",
    "dist:win": "electron-vite build && electron-builder --win --publish never && tsx scripts/verify-packaged-binaries.ts",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never && tsx scripts/verify-packaged-binaries.ts",
    "demo-pack": "tsx scripts/demo-render-pack.ts",
    "test:fonts": "tsx scripts/test-fonts.ts",
    "test:export-presets": "tsx scripts/test-export-presets.ts",
    "test:watermark": "tsx scripts/test-watermark.ts",
    "test:rc-qa": "tsx scripts/rc-qa.ts",
    "test:template-cover": "tsx scripts/test-template-cover.ts",
    "test:progress-motion": "tsx scripts/test-real-progress-motion.ts",
    "test:media-loading": "tsx scripts/test-media-loading.ts",
    "test:whisper-bundle": "tsx scripts/test-whisper-bundle.ts",
    "test:display-toggles": "tsx scripts/test-display-toggles.ts",
    "whisper:compare": "tsx scripts/whisper-language-compare.ts",
    "test:media-protocol": "tsx scripts/test-media-protocol.ts",
    "test:media-probe": "tsx scripts/test-media-probe.ts",
    "test:video-export": "tsx scripts/test-video-export.ts",
    "release-qa": "tsx scripts/release-qa.ts",
    "fetch:whisper": "bash scripts/fetch-whisper.sh",
    "icons": "tsx scripts/build-icons.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@fiahfy/icns-convert": "^0.0.12",
    "@napi-rs/canvas": "^1.0.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.louver.lyric-shorts-maker",
    "productName": "Lyric Shorts Maker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "assets/fonts",
        "filter": [
          "**/*.ttf",
          "**/*.otf",
          "**/*.woff2",
          "README.md"
        ]
      },
      {
        "from": "resources/whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 Louver",
        "LSApplicationCategoryType": "public.app-category.video"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio",
      "icon": "build/icon.png"
    },
    "dmg": {
      "writeUpdateInfo": true,
      "title": "Lyric Shorts Maker ${version}",
      "icon": "build/icon.icns",
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        { "x": 160, "y": 200, "type": "file" },
        { "x": 500, "y": 200, "type": "link", "path": "/Applications" },
        {
          "x": 160,
          "y": 360,
          "type": "file",
          "path": "build/dmg/Unblock Lyric Shorts Maker.command"
        },
        {
          "x": 500,
          "y": 360,
          "type": "file",
          "path": "build/dmg/처음 실행이 안 되면 읽어주세요.txt"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "freemilesarea-boop",
        "repo": "Louver-Lyric-Shorts-Maker-MVP",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ]
  }
}
