{
  "name": "louver-lyric-shorts-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Generate 9:16 lyric shorts from a single image, audio file, and lyrics.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "demo-pack": "tsx scripts/demo-render-pack.ts",
    "test:fonts": "tsx scripts/test-fonts.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.louver.lyric-shorts-maker",
    "productName": "Lyric Shorts Maker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "assets/fonts",
        "filter": ["**/*.ttf", "**/*.otf", "**/*.woff2", "README.md"]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio",
      "icon": "build/icon.png"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ]
  }
}
